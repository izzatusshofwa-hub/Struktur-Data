import random

# Insertion Sort
def insertion_sort(arr):
    a = arr.copy()
    comparisons = 0
    swaps = 0

    for i in range(1, len(a)):
        key = a[i]
        j = i - 1

        while j >= 0:
            comparisons += 1
            if a[j] > key:
                a[j+1] = a[j]
                swaps += 1
                j -= 1
            else:
                break

        a[j+1] = key

    return a, comparisons + swaps


# Selection Sort
def selection_sort(arr):
    a = arr.copy()
    comparisons = 0
    swaps = 0
    n = len(a)

    for i in range(n):
        min_idx = i
        for j in range(i+1, n):
            comparisons += 1
            if a[j] < a[min_idx]:
                min_idx = j

        if min_idx != i:
            a[i], a[min_idx] = a[min_idx], a[i]
            swaps += 1

    return a, comparisons + swaps


# Hybrid Sort
def hybridSort(theSeq, threshold=10):
    if len(theSeq) <= threshold:
        return insertion_sort(theSeq)
    else:
        return selection_sort(theSeq)


# Pengujian
sizes = [50, 100, 500]

print("Ukuran | Hybrid Ops | Insertion Ops | Selection Ops")

for size in sizes:
    data = [random.randint(1, 1000) for _ in range(size)]

    hybrid_ops = hybridSort(data)[1]
    insertion_ops = insertion_sort(data)[1]
    selection_ops = selection_sort(data)[1]

    print(size, "|", hybrid_ops, "|", insertion_ops, "|", selection_ops)
